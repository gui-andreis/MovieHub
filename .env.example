# Copie para .env (usado pelo docker-compose) — NUNCA commite o .env
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@moviehub.com
ADMIN_PASSWORD=Admin@123
CORS_ALLOWED_ORIGINS=http://localhost:3000
# "API Read Access Token" do TMDB (themoviedb.org → Settings → API)
TMDB_READ_ACCESS_TOKEN=
TMDB_SEED_MOVIES=300
TMDB_SEED_SERIES=120

